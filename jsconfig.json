{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "eslint.config.js"],
  "exclude": ["node_modules", "scripts"]
}
