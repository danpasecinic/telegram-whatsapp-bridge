# Copy to scripts/.env.deploy (gitignored) and fill in.
# Used by scripts/deploy.sh.

# Hostname or IP of the EC2 instance (required).
EC2_HOST=

# SSH user (default: ec2-user).
# EC2_USER=ec2-user

# Path to the private SSH key (default: your ssh default key).
# Quote the value if the path contains spaces. A space-free path is easiest.
# SSH_KEY=~/.ssh/ec2-twb.pem
# SSH_KEY="/Users/you/.ssh/My Key With Spaces.pem"

# Directory on the box that holds the checkout (default: telegram-whatsapp-bridge).
# REMOTE_DIR=telegram-whatsapp-bridge

# Docker image tag (default: tg-wa-bridge).
# IMAGE_NAME=tg-wa-bridge
