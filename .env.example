# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Channel ID to monitor (e.g., -1001234567890)
# Add the bot as admin to your channel to receive messages
TELEGRAM_CHANNEL_ID=-1001234567890

# Optional: your personal Telegram user ID to receive DM alerts when WhatsApp
# needs re-authentication (QR re-scan), disconnects, or auth fails.
# You must send /start to the bot once so it is allowed to DM you.
# Get your ID from @userinfobot. Leave empty to disable alerts.
TELEGRAM_ALERT_CHAT_ID=

# WhatsApp Group/Channel ID (you'll get this after first run)
# Format: 1234567890@g.us for groups or 1234567890@newsletter for channels
WHATSAPP_CHAT_ID=

# OR use channel invite code (from URL like whatsapp.com/channel/XXXXX)
# WHATSAPP_CHANNEL_INVITE=0029VadCBGj9Gv7UtcJALE0o

# Optional settings
# LOG_DIR=./logs
# DATA_DIR=./data
# DEBUG=1
